# =====================================================
# MediConnect — Environment Variables
# =====================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME="MediConnect"
NEXT_PUBLIC_APP_URL="https://www.mediconnectdz.com"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# --- Database (Phase 3) ---
# Dev (SQLite — zero-config, file-based):
DATABASE_URL="file:./prisma/dev.db"
# Prod (Postgres — change `provider` in prisma/schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://user:password@localhost:5432/mediconnect"

# --- Authentication ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="change-me-in-production-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# --- Payment gateways (Phase 3.5 — stubs in Phase 3) ---
SATIM_MERCHANT_ID=""
SATIM_API_KEY=""
SATIM_API_URL="https://cib.satim.dz/payment/rest/"
SATIM_WEBHOOK_SECRET=""

# --- CCP manual payment ---
CCP_ACCOUNT_NUMBER="1234567"
CCP_ACCOUNT_KEY="00"
CCP_ACCOUNT_HOLDER="MEDICONNECT SARL"

# --- Storage (Phase 3) ---
# Where uploaded CCP proofs, product images, used-listing photos live.
# Dev: local filesystem under ./uploads (default).
# Prod: S3/Wasabi.
UPLOADS_DIR="./uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- Observability (Phase 3.5) ---
# LOG_LEVEL controls the structured logger threshold: debug | info | warn | error
# Defaults to 'debug' in dev and 'info' in production.
LOG_LEVEL="debug"

# --- Email (Phase 3.5 — dry-runs to console without a key) ---
# Leave RESEND_API_KEY unset to log email previews in the terminal instead
# of actually sending. Set it in production to enable real delivery.
RESEND_API_KEY=""
EMAIL_FROM="MediConnect <noreply@mediconnectdz.com>"

# --- SMS (Phase 4) ---
# SMS_PROVIDER=""
# SMS_API_KEY=""
