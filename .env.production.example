# =============================================================================
#  MediConnect — Production environment
# =============================================================================
#
#  Copy this file to `.env.production` and fill in every variable marked
#  REQUIRED. Anything marked OPTIONAL has a safe default.
#
#  Generate JWT_SECRET:         openssl rand -base64 32
#  Generate POSTGRES_PASSWORD:  openssl rand -base64 24
#
#  Never commit .env.production to git. The .gitignore already excludes it.
# =============================================================================

# --- App identity (REQUIRED) ---
NEXT_PUBLIC_APP_NAME="MediConnect"
NEXT_PUBLIC_APP_URL="https://www.mediconnectdz.com"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# --- Database (REQUIRED) ---
POSTGRES_USER="mediconnect"
POSTGRES_DB="mediconnect"
POSTGRES_PASSWORD="CHANGE-ME-generate-with-openssl"

# --- Authentication (REQUIRED) ---
# MUST be a strong random string of at least 32 characters.
JWT_SECRET="aD4X8Qy19H4pE7zBw6lXm2nJ5rV0qF3gE2dC1bA09Z8Y7X6W5V4"
JWT_EXPIRES_IN="7d"

# --- CCP / Baridi Mob (REQUIRED for CCP payments to display) ---
# These appear on the checkout/success page when a customer picks CCP.
CCP_ACCOUNT_NUMBER="1257019688"
CCP_ACCOUNT_KEY="56"
CCP_ACCOUNT_HOLDER="MEDICONNECT SARL"

# --- Logging (OPTIONAL, default: info) ---
LOG_LEVEL="info"

# --- Email (OPTIONAL — unset means dev-style terminal previews) ---
# Sign up at resend.com, then put the API key here to enable real delivery.
RESEND_API_KEY=""
EMAIL_FROM="MediConnect <noreply@mediconnectdz.com>"

# --- Satim 3-D Secure (OPTIONAL — Phase 4) ---
# Leave empty until you have a merchant agreement with CIB / Satim.
# The site's Edahabia flow gracefully falls back to the stub when unset.
SATIM_MERCHANT_ID=""
SATIM_API_KEY=""
SATIM_API_URL="https://cib.satim.dz/payment/rest/"
SATIM_WEBHOOK_SECRET=""

# --- Storage (OPTIONAL — defaults to local disk) ---
# S3_BUCKET="mediconnect-uploads"
# S3_REGION="eu-west-3"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- SMS (OPTIONAL — Phase 4) ---
# SMS_PROVIDER="twilio"
# SMS_API_KEY=""
