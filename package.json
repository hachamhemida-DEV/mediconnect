{
  "name": "mediconnect",
  "version": "0.2.0",
  "private": true,
  "description": "MediConnect — Smart medical equipment marketplace for Algeria",
  "scripts": {
    "dev":        "next dev",
    "build":      "prisma generate && next build",
    "start":      "next start",
    "lint":       "next lint",
    "typecheck":  "tsc --noEmit",
    "db:generate":"prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push":    "prisma db push",
    "db:seed":    "prisma db seed",
    "db:reset":   "prisma migrate reset",
    "db:studio":  "prisma studio",
    "postinstall":"prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs":       "^2.4.3",
    "clsx":           "^2.1.1",
    "jose":           "^5.9.6",
    "next":           "^15.5.15",
    "next-intl":      "^3.26.0",
    "react":          "19.0.0",
    "react-dom":      "19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod":            "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs":    "^2.4.6",
    "@types/node":        "^22.10.0",
    "@types/react":       "^19.0.0",
    "@types/react-dom":   "^19.0.0",
    "autoprefixer":       "^10.4.20",
    "eslint":             "^9.17.0",
    "eslint-config-next": "15.1.0",
    "postcss":            "^8.5.0",
    "prisma":             "^5.22.0",
    "tailwindcss":        "^3.4.17",
    "tsx":                "^4.19.0",
    "typescript":         "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
